# Copy to .env for local development. Never commit real values — see docs/ENVIRONMENT.md.

NODE_ENV=development
PORT=4000

LOG_LEVEL=info

# MongoDB Atlas connection string (local dev may point at a local mongod instance)
MONGODB_URI=mongodb://localhost:27017/astroai

# Redis connection string (caching, rate limiting, BullMQ, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call this API with credentials (admin panel URL(s))
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting foundation defaults
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
