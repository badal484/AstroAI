# Copy to .env for local development. Never commit real values — see docs/ENVIRONMENT.md.

NODE_ENV=development
PORT=4000

LOG_LEVEL=info

# MongoDB Atlas connection string. Atlas clusters are always replica sets;
# for LOCAL development, `mongod` must also be run as a (single-node)
# replica set — auth uses multi-document transactions, which a plain
# standalone mongod rejects. Example:
#   mongod --dbpath ./data --replSet rs0 --port 27017
#   mongosh --port 27017 --eval "rs.initiate()"
MONGODB_URI=mongodb://localhost:27017/astroai

# Redis connection string (caching, rate limiting, BullMQ, Socket.IO adapter)
REDIS_URL=redis://localhost:6379

# Comma-separated list of origins allowed to call this API with credentials (admin panel URL(s))
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting foundation defaults
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# --- End-user auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-generated-64-char-hex-secret-for-local-dev-only
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Admin auth (fully separate secret from end-user auth) ---
ADMIN_JWT_ACCESS_SECRET=replace-with-a-different-generated-64-char-hex-secret
ADMIN_JWT_ACCESS_TTL_SECONDS=900
ADMIN_JWT_REFRESH_TTL_SECONDS=2592000
# Set only in production, when admin.<domain> and api.<domain> share a
# registrable domain the session cookies should be scoped to (e.g. ".astroai.app").
ADMIN_COOKIE_DOMAIN=

# --- Google OAuth (end-user sign-in) ---
# The OAuth "Web client ID" from Google Cloud Console — used as the expected
# audience when verifying ID tokens from every platform, mobile included.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Admin seed script only (backend/scripts/seedAdmin.ts) — not read by the server ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=
